# Copy to .env and adjust. All values below are SAFE EXAMPLES for local use only.
POSTGRES_USER=chirp
POSTGRES_PASSWORD=chirp_dev_password
POSTGRES_DB=chirp
# Secret used to sign session tokens. Generate a real one with: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
# Host port the web UI is exposed on
WEB_PORT=8080
